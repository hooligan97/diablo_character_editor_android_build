<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#121212">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilGold"
        style="@style/DarkEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Złoto">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etGold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilHelmet"
        style="@style/DarkEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Hełm (ID)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etHelmet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilArmor"
        style="@style/DarkEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Zbroja (ID)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etArmor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilWeapon"
        style="@style/DarkEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Broń (ID)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etWeapon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilShield"
        style="@style/DarkEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tarcza (ID)">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etShield"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <Button
        android:id="@+id/btnSaveEquipment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Zapisz Ekwipunek"
        style="@style/DiabloButton" />

</LinearLayout>
